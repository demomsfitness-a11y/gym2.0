{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and state",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "membershipStatus": { "type": "string", "enum": ["none", "pending", "approved", "active", "expired"] },
        "activePlanId": { "type": "string" },
        "activePlanName": { "type": "string" },
        "membershipExpiryDate": { "type": "string" },
        "joinedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "MembershipRequest": {
      "title": "MembershipRequest",
      "description": "Request for a membership activation or renewal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "price": { "type": "number" },
        "duration": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "active", "expired"] },
        "paymentMethod": { "type": "string" },
        "paymentProof": { "type": "string" },
        "createdAt": { "type": "string" },
        "adminNotes": { "type": "string" }
      },
      "required": ["id", "userId", "planId", "status"]
    },
    "GroupClass": {
      "title": "GroupClass",
      "description": "Gym scheduled classes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "trainerId": { "type": "string" },
        "trainerName": { "type": "string" },
        "time": { "type": "string" },
        "day": { "type": "string" },
        "capacity": { "type": "number" },
        "bookedCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "time", "day", "capacity"]
    },
    "Booking": {
      "title": "Booking",
      "description": "User booking for a class or trainer session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "trainerId": { "type": "string" },
        "trainerName": { "type": "string" },
        "time": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["booked", "cancelled"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "status"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Important notifications or gym notices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "scheduledFor": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "createdAt"]
    },
    "Trainer": {
      "title": "Trainer",
      "description": "Gym fitness trainers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "photoURL": { "type": "string" },
        "socialFacebook": { "type": "string" },
        "socialInstagram": { "type": "string" },
        "socialTwitter": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "specialty"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "User support query ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "replies": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "subject", "message", "status"]
    },
    "ContactSubmission": {
      "title": "ContactSubmission",
      "description": "Web contact form submissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["unread", "read", "replied"] },
        "adminNotes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "message", "status"]
    },
    "GalleryMedia": {
      "title": "GalleryMedia",
      "description": "Media item in the gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video"] },
        "album": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "url", "type"]
    },
    "WebsiteContent": {
      "title": "WebsiteContent",
      "description": "Editable landing page section contents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile database"
    },
    "/membershipRequests/{requestId}": {
      "schema": "MembershipRequest",
      "description": "Membership request logs and approvals"
    },
    "/groupClasses/{classId}": {
      "schema": "GroupClass",
      "description": "Gym scheduled classes"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Class and session bookings"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Announcements and gym notices"
    },
    "/trainers/{trainerId}": {
      "schema": "Trainer",
      "description": "Fitness trainers"
    },
    "/supportTickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support tickets submitted by users"
    },
    "/contactSubmissions/{submissionId}": {
      "schema": "ContactSubmission",
      "description": "Contact form responses"
    },
    "/gallery/{mediaId}": {
      "schema": "GalleryMedia",
      "description": "Gym media gallery"
    },
    "/websiteContent/{contentId}": {
      "schema": "WebsiteContent",
      "description": "Dynamic editable homepage section contents"
    }
  }
}
